@model IEnumerable<Eventos3315298.Models.Municipio>

@{
    ViewData["Title"] = "Index";
}

<h1>Gestion de Municipios</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

@* Capturar los errores enviados con el TempData *@
@if(TempData["Error"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Nombre)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MunicipioId" class="btn btn-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.MunicipioId" class="btn btn-warning" >Details</a> 
                    <a asp-action="Delete" asp-route-id="@item.MunicipioId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>